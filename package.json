  "name": "3yellow3white",
  "private": true,
  "type": "module",
  "workspaces": [
    "frontend/animlib"
  ],
  "overrides": {
    "@xmldom/xmldom": "0.9.12"
  },
  "scripts": {
    "dev": "npm run dev --workspace animlib",
