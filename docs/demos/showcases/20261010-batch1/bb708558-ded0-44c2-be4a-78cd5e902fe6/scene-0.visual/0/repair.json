{"sourceSha256":"01e33b12ac91568a1054bdf615fc321f5462cdaf7054c230b778d59b0ffd9653","edits":[{"finding":0,"before":"  let core, assembly, focusBond, secondaryBonds, oxygenLabel, nitrogenLabel;","after":"  let core, assembly, focusBond, secondaryBonds, oxygenLabel, nitrogenLabel, oxygenLeader, nitrogenLeader;"},{"finding":0,"before":"    oxygenLabel=v.latex('acceptor-label',{tex:'O_i',fontSize:0.64,fill:Color.RED,billboard:true,billboardOffset:[-0.15,1.1,0.5],opacity:0});\n    nitrogenLabel=v.latex('donor-label',{tex:'N_{i+4}',fontSize:0.64,fill:Color.BLUE,billboard:true,billboardOffset:[0.2,1.15,0.5],opacity:0});\n    v.attach(oxygenLabel,atoms[4].O);\n    v.attach(nitrogenLabel,atoms[8].N);","after":"    oxygenLabel=v.latex('acceptor-label',{tex:'O_i',fontSize:0.64,fill:Color.RED,billboard:true,opacity:0});\n    nitrogenLabel=v.latex('donor-label',{tex:'N_{i+4}',fontSize:0.64,fill:Color.BLUE,billboard:true,opacity:0});\n    v.attach(oxygenLabel,atoms[4].O,{offset:[2,-2.4,1]});\n    v.attach(nitrogenLabel,atoms[8].N,{offset:[-2.8,3.4,1]});\n    const oxygenTip=v.sphere('acceptor-leader-tip',{radius:0.001,opacity:0});\n    const nitrogenTip=v.sphere('donor-leader-tip',{radius:0.001,opacity:0});\n    v.attach(oxygenTip,atoms[4].O,{offset:[1.7,-1.9,1]});\n    v.attach(nitrogenTip,atoms[8].N,{offset:[-2.5,2.8,1]});\n    oxygenLeader=v.line3D('acceptor-leader',{stroke:Color.RED,strokeWidth:0.035,opacity:0});\n    nitrogenLeader=v.line3D('donor-leader',{stroke:Color.BLUE,strokeWidth:0.035,opacity:0});\n    v.connect(oxygenLeader,atoms[4].O,oxygenTip,{endpoints:'surface'});\n    v.connect(nitrogenLeader,atoms[8].N,nitrogenTip,{endpoints:'surface'});"},{"finding":0,"before":"  playTo(D*0.65,[focusBond.fadeIn(),oxygenLabel.fadeIn(),nitrogenLabel.fadeIn(),relationship.fadeIn(),hCaption.fadeIn()]);","after":"  playTo(D*0.65,[focusBond.fadeIn(),oxygenLabel.fadeIn(),nitrogenLabel.fadeIn(),oxygenLeader.fadeIn(),nitrogenLeader.fadeIn(),relationship.fadeIn(),hCaption.fadeIn()]);"}]}