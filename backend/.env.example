# Server-only. Copy to backend/.env.local for local development.
# Enable real script + scene generation after agents:login and agents:check succeed.
VIDEO_GENERATOR=pi
AGENT_AUTH_MODE=subscription
AGENT_PROVIDER=openai
AGENT_MODEL=gpt-6.1-sol
AGENT_THINKING=medium
AGENT_TIMEOUT_MS=300000
# API-key mode reads this key and ignores saved subscription credentials.
OPENAI_API_KEY=
# Local default: ~/.aha/pi; use the same directory for login and backend commands.
# PI_CODING_AGENT_DIR=/absolute/private/path/pi
# To reuse a local Pi login, set AGENT_PROVIDER=openai-codex and
# PI_CODING_AGENT_DIR=/home/your-user/.pi/agent. No credential copying is needed.
# Local default: backend/data/agents. Docker sets this to /data/agents/jobs.
# AGENT_DATA_DIR=/absolute/path/agent-jobs
# Deployment-only host directory; defaults to /srv/apps/3yellow3white-actions/agents.
# AGENT_STATE_DIR=/absolute/private/path/agent-state
ELEVENLABS_API_KEY=
# Alexander - Clear, Steady and Refined (verified in the project ElevenLabs account)
ELEVENLABS_VOICE_ID=hIru3zkEJ3dBYHTbMy2V
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
# Local default is backend/.narration; production Compose manages its persistent mount.
# NARRATION_DATA_DIR=/absolute/private/path/narration
# Only for a backend bound to loopback during local development; ignored in production.
NARRATION_ALLOW_LOCAL=0
# Set only behind the production gateway; omit for local development.
# NARRATION_PUBLIC_ORIGIN=https://11.hackathon.ethz.ch
